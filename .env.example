PORT=6060
MONGODB_URI=mongodb://127.0.0.1:27017/chat_app
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-32-character-random-string
CLIENT_ORIGIN=http://localhost:8081

# Cloudinary (used for all media uploads). Leave the secret blank only if you
# prefer local disk storage.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=morrow
